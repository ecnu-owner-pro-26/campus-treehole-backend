# ===========================================
# 校园树洞后端 - 环境变量配置示例（微信小程序版）
# ===========================================
# 复制此文件为 .env 并根据实际情况修改配置值

# ===========================================
# 微信小程序配置（必需）
# ===========================================
# 微信小程序 AppID
WECHAT_APPID=your_wechat_appid
# 微信小程序 AppSecret
WECHAT_SECRET=your_wechat_secret

# ===========================================
# JWT 认证配置（必需）
# ===========================================
# JWT 签名密钥（生产环境请使用复杂的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT Token 过期时间（小时，默认168小时=7天）
JWT_EXPIRE_HOURS=168

# ===========================================
# 服务器配置
# ===========================================
# HTTP 服务器监听端口
SERVER_PORT=8080
# 服务器监听地址
SERVER_HOST=0.0.0.0
# Gin 运行模式: debug, release
GIN_MODE=debug

# ===========================================
# 数据库配置
# ===========================================
# 数据库类型: postgres, mysql, sqlite
DB_TYPE=postgres
# 数据库主机地址
DB_HOST=localhost
# 数据库端口
DB_PORT=5432
# 数据库用户名
DB_USER=postgres
# 数据库密码
DB_PASSWORD=password
# 数据库名称
DB_NAME=campus_treehole
# 数据库字符集
DB_CHARSET=utf8mb4
# 连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=60

# SQLite 配置（如果使用 SQLite）
# DB_TYPE=sqlite
# DB_PATH=./data/campus_treehole.db

# ===========================================
# Redis 缓存配置（可选）
# ===========================================
# 是否启用 Redis
REDIS_ENABLED=false
# Redis 服务器地址
REDIS_HOST=localhost
# Redis 服务器端口
REDIS_PORT=6379
# Redis 密码（如果有）
REDIS_PASSWORD=
# Redis 数据库编号
REDIS_DB=0

# ===========================================
# 文件上传配置
# ===========================================
# 文件上传目录
UPLOAD_DIR=./storage/uploads
# 最大文件大小（MB）
MAX_FILE_SIZE=10
# 允许的图片类型
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
# 允许的音频类型
ALLOWED_AUDIO_TYPES=mp3,wav,m4a

# ===========================================
# 对象存储配置（可选，用于生产环境）
# ===========================================
# 是否启用对象存储（如阿里云OSS、腾讯云COS）
OSS_ENABLED=false
# OSS 访问域名
OSS_ENDPOINT=
# OSS Access Key
OSS_ACCESS_KEY=
# OSS Secret Key
OSS_SECRET_KEY=
# OSS Bucket 名称
OSS_BUCKET=

# ===========================================
# 跨域配置
# ===========================================
# 允许的跨域来源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=*
# 允许的 HTTP 方法
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# 允许的请求头
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
# 是否允许携带凭证
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# 日志配置
# ===========================================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info
# 日志输出格式: json, text
LOG_FORMAT=text
# 日志文件路径（留空表示只输出到控制台）
LOG_FILE=./logs/app.log

# ===========================================
# 安全配置
# ===========================================
# API 限流配置（每分钟请求数）
RATE_LIMIT_PER_MINUTE=100
# 是否启用 HTTPS
HTTPS_ENABLED=false

# ===========================================
# 开发调试配置
# ===========================================
# 是否启用调试模式
DEBUG=true
# 是否启用 SQL 查询日志
DB_DEBUG=true